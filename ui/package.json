{
  "name": "@cutokyo/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/check-production-bundle.ts",
    "generate:settings": "node ../tools/generate-settings-types.mjs",
    "check:settings": "node ../tools/generate-settings-types.mjs --check",
    "check:production-fixtures": "tsx scripts/check-production-bundle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts vite.config.ts vitest.config.ts playwright.config.ts wdio.conf.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm test:native-harness",
    "test:a11y": "vitest run src/accessibility.test.tsx",
    "test:e2e:web": "playwright test",
    "build:e2e:tauri:ui": "vite build --mode native-e2e",
    "test:native-harness": "python3 -m unittest discover -s scripts -p 'test_native_e2e.py' -v",
    "test:e2e:tauri": "pnpm build && python3 scripts/native-e2e.py",
    "test:e2e:tauri:runner": "wdio run ./wdio.conf.ts",
    "knip": "knip",
    "check": "pnpm check:settings && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm knip"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "@wdio/types": "9.30.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.0",
    "knip": "6.37.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "webdriverio": "9.31.9"
  }
}
