{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutokyo",
  "version": "0.1.0",
  "identifier": "dev.cutokyo.desktop",
  "build": {
    "frontendDist": "../../ui/foundation"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cutokyo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
