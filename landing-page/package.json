{
  "name": "cutokyo-front-end",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=20.9.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.9.0",
    "basic-ftp": "5.3.1",
    "fast-uri": "3.1.2",
    "form-data": "4.0.6",
    "ip-address": "10.2.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "postcss": "8.5.18",
    "protobufjs": "7.6.5",
    "smol-toml": "1.7.0",
    "tmp": "0.2.7",
    "vite": "8.1.4",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "audit:dependencies": "bun run ./scripts/audit-dependencies.mjs",
    "build:desktop": "bun run ./scripts/build-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:linux": "tauri build --bundles deb",
    "desktop:build:linux:appimage": "tauri build --bundles appimage",
    "desktop:build:macos": "tauri build --bundles dmg",
    "desktop:build:windows": "tauri build --bundles nsis",
    "desktop:build:windows:local": "node ./scripts/build-windows-local.mjs",
    "desktop:build:windows:desktop": "node ./scripts/build-windows-local.mjs --copy-to-desktop",
    "desktop:smoke:auth": "node ./scripts/smoke-desktop-auth.mjs",
    "desktop:smoke:clis": "node ./scripts/smoke-desktop-clis.mjs",
    "start": "next start",
    "check:fast": "bun run ./scripts/run-checks.mjs check:fast",
    "typecheck": "tsc -b --pretty false",
    "lint": "node node_modules/eslint/bin/eslint.js . --cache --cache-location .eslintcache --concurrency auto --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint-staged": "lint-staged",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run --pool vmThreads --passWithNoTests=false",
    "test:coverage": "vitest run --pool vmThreads --passWithNoTests=false --coverage",
    "test:watch": "vitest",
    "depcruise": "bun node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config .dependency-cruiser.mjs src",
    "knip": "knip",
    "openapi:generate": "bun run ./scripts/generate-openapi-types.mjs",
    "lighthouse:changed": "bun run ./scripts/lighthouse-changed-routes.mjs",
    "validate": "bun run ./scripts/run-checks.mjs validate",
    "validate:push": "bun run ./scripts/run-checks.mjs validate:push",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write",
    "*.{ts,tsx,mts}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "5.101.2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@workos-inc/authkit-nextjs": "^4.2.0",
    "@workos-inc/node": "^10.7.0",
    "@workos-inc/widgets": "1.15.0",
    "client-only": "^0.0.1",
    "next": "16.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "lefthook": "^2.1.10",
    "lighthouse": "^13.4.0",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.16",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "secretlint": "^11.7.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "sharp",
    "unrs-resolver"
  ]
}
